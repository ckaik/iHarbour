diff --git a/src/port/Game.cpp b/src/port/Game.cpp
index ef7894be..e09c17dc 100644
--- a/src/port/Game.cpp
+++ b/src/port/Game.cpp
@@ -2,6 +2,9 @@
 
 #include <Fast3D/interpreter.h>
 #include "Engine.h"
+#ifdef HARBOUR_IOS
+#include <filesystem>
+#endif
 
 extern "C" {
 #include <sf64mesg.h>
@@ -31,6 +34,16 @@ void push_frame() {
 
 #ifdef _WIN32
 int SDL_main(int argc, char **argv) {
+#elif defined(HARBOUR_IOS)
+// iHarbour: the launcher app owns main() and starts the game through HarbourEngine.
+extern "C" int HarbourGame_Main(int argc, char* argv[]) {
+    // The launcher extracts ROMs itself and only starts the game once sf64.o2r exists. Without it the game would
+    // offer to extract a ROM it can't pick on iOS, and then exit the whole app.
+    if (!std::filesystem::exists(Ship::Context::GetPathRelativeToAppDirectory("sf64.o2r"))) {
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Starship", "sf64.o2r is missing. Add a ROM in iHarbour first.",
+                                 nullptr);
+        return 1;
+    }
 #else
 #if defined(__cplusplus) && defined(PLATFORM_IOS)
 extern "C"
