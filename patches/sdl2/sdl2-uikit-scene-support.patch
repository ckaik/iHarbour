+#if !TARGET_OS_TV
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(void)
+{
+    if (@available(iOS 13.0, *)) {
+        UIWindowScene *fallback = nil;
+        for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+            UIWindowScene *windowScene;
+            if (![scene isKindOfClass:[UIWindowScene class]]) {
+                continue;
+            }
+            windowScene = (UIWindowScene *)scene;
+            if (windowScene.activationState == UISceneActivationStateForegroundActive) {
+                fallback = windowScene;
+                break;
+            }
+            if (fallback == nil) {
+                fallback = windowScene;
+            }
+        }
+        if (fallback != nil) {
+            if (@available(iOS 16.0, *)) {
+                return fallback.effectiveGeometry.interfaceOrientation;
+            }
+            return fallback.interfaceOrientation;
+        }
+    }
+    return [UIApplication sharedApplication].statusBarOrientation;
+}
+#endif
+
+UIWindow *UIKit_CreateUIWindow(Class windowClass, UIScreen *screen)
+{
+    if (@available(iOS 13.0, tvOS 13.0, *)) {
+        UIWindowScene *fallback = nil;
+        for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+            UIWindowScene *windowScene;
+            if (![scene isKindOfClass:[UIWindowScene class]]) {
+                continue;
+            }
+            windowScene = (UIWindowScene *)scene;
+            if (windowScene.screen != screen) {
+                continue;
+            }
+            if (windowScene.activationState == UISceneActivationStateForegroundActive) {
+                return [[windowClass alloc] initWithWindowScene:windowScene];
+            }
+            if (fallback == nil) {
+                fallback = windowScene;
+            }
+        }
+        if (fallback != nil) {
+            return [[windowClass alloc] initWithWindowScene:fallback];
+        }
+    }
+    return [[windowClass alloc] initWithFrame:screen.bounds];
+}
