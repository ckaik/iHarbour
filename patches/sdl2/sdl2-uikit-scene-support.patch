+/* Creates a UIWindow of the given class. Apps that use the UIScene lifecycle
+ * need every window attached to a UIWindowScene or it never becomes visible,
+ * so this prefers the active scene on the given screen and only falls back to
+ * a scene-less, screen-sized window for apps without scenes. */
+UIWindow *UIKit_CreateUIWindow(Class windowClass, UIScreen *screen);
+
+#if !TARGET_OS_TV
+/* The app's interface orientation. Scene-based apps don't keep
+ * -[UIApplication statusBarOrientation] up to date, so this asks the active
+ * window scene when there is one. */
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(void);
+#endif
+
 #endif /* __OBJC__ */
 
