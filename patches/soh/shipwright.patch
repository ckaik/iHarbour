-add_executable(${PROJECT_NAME} ${ALL_FILES})
+if (HARBOUR_ROOT)
+    # iHarbour: on iOS the game is not an app of its own. It builds as a framework
+    # that the iHarbour launcher app loads and runs in its own process.
+    add_library(${PROJECT_NAME} SHARED ${ALL_FILES})
+    harbour_add_game_framework(${PROJECT_NAME})
+else()
+    add_executable(${PROJECT_NAME} ${ALL_FILES})
+endif()
 
 if (CMAKE_SYSTEM_NAME STREQUAL "Windows")
 use_props(${PROJECT_NAME} "${CMAKE_CONFIGURATION_TYPES}" "${DEFAULT_CXX_PROPS}")
@@ -387,6 +394,24 @@ elseif (CMAKE_SYSTEM_NAME STREQUAL "CafeOS")
         SPDLOG_ACTIVE_LEVEL=${SPDLOG_MIN_CUTOFF}
         LOG_LEVEL_GAME_PRINTS=${SPDLOG_LEVEL_OFF}
     )
+elseif (CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # Same as the Clang block below, minus ENABLE_OPENGL: iOS renders through Metal.
+    target_compile_definitions(${PROJECT_NAME} PRIVATE
+        "$<$<CONFIG:Debug>:"
+            "_DEBUG;"
+        ">"
+        "$<$<CONFIG:Release>:"
+            "NDEBUG;"
+        ">"
+        "F3DEX_GBI_2;"
+        "_CONSOLE;"
+        "_CRT_SECURE_NO_WARNINGS;"
+        "UNICODE;"
+        "_UNICODE;"
+        "__IOS__;"
+        SPDLOG_ACTIVE_LEVEL=${SPDLOG_MIN_CUTOFF}
+        LOG_LEVEL_GAME_PRINTS=${SPDLOG_LEVEL_OFF}
+    )
 elseif ("${CMAKE_CXX_COMPILER_ID}" MATCHES "GNU|Clang|AppleClang")
     target_compile_definitions(${PROJECT_NAME} PRIVATE
         "$<$<CONFIG:Debug>:"
@@ -482,7 +507,7 @@ if(MSVC)
 endif()
 
 if (CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
-    if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+    if (CMAKE_SYSTEM_NAME MATCHES "Darwin|iOS")
         target_compile_options(${PROJECT_NAME} PRIVATE
             -Wall -Wextra -Wno-error
             -Wformat-security
@@ -605,12 +630,15 @@ if (CMAKE_GENERATOR MATCHES "Visual Studio")
     COMMAND ${CMAKE_COMMAND} -E copy_directory_if_different ${CMAKE_SOURCE_DIR}/soh/assets/yml ${CMAKE_BINARY_DIR}/soh/assets
     )
 endif()
+# On iOS scripts/build-engine.sh in iHarbour puts the ymls into the framework.
+if (NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
 add_custom_command(
     TARGET ${PROJECT_NAME}
     POST_BUILD
     COMMENT "Copying asset ymls..."
     COMMAND ${CMAKE_COMMAND} -E copy_directory_if_different ${CMAKE_SOURCE_DIR}/soh/assets/yml $<TARGET_FILE_DIR:soh>/assets
 )
+endif()
