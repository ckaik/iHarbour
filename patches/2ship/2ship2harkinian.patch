diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0699eff46..104e285be 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -180,6 +180,18 @@ set_property(GLOBAL PROPERTY USE_FOLDERS ON)
 ################################################################################
 add_compile_definitions(CONTROLLERBUTTONS_T=uint32_t)
 
+################################################################################
+# iHarbour (iOS): dependencies desktop builds take from the system, and the
+# helper that turns the game into a framework for the launcher app
+################################################################################
+if(HARBOUR_ROOT)
+    include(${HARBOUR_ROOT}/cmake/HarbourIOS.cmake)
+endif()
+
+# iHarbour builds 2ship.o2r with a macOS build of ZAPD, which needs libultraship
+# and OTRExporter but not the game.
+option(HARBOUR_TOOLS_ONLY "Configure only ZAPD and 2ship.o2r, skipping the game" OFF)
+
 ################################################################################
 # Sub-projects
 ################################################################################
@@ -206,6 +218,34 @@ endif()
 
 add_subdirectory(ZAPDTR/ZAPD ${CMAKE_BINARY_DIR}/ZAPD)
 add_subdirectory(OTRExporter)
+
+if(HARBOUR_ROOT)
+    # OTRExporter includes tinyxml2's and libzip's headers without linking
+    # them. Desktop builds find them in the system's include directory.
+    target_link_libraries(OTRExporter PRIVATE tinyxml2::tinyxml2 libzip::zip)
+endif()
+
+if(HARBOUR_TOOLS_ONLY)
+    # What Generate2ShipOtr below does, as a build step with outputs, so that
+    # building it again is a no-op until ZAPD or the custom assets change.
+    file(GLOB_RECURSE HARBOUR_CUSTOM_ASSETS CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/mm/assets/custom/*)
+    file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/mm)
+    add_custom_command(
+        OUTPUT ${CMAKE_BINARY_DIR}/mm/2ship.o2r
+        # ZAPD does nothing if the archive exists already.
+        COMMAND ${CMAKE_COMMAND} -E rm -f 2ship.o2r
+        COMMAND $<TARGET_FILE:ZAPD> botr -se OTR --norom
+                --customAssetsPath ${CMAKE_CURRENT_SOURCE_DIR}/mm/assets/custom
+                --customOtrFile 2ship.o2r
+                --portVer ${CMAKE_PROJECT_VERSION}
+        WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/mm
+        DEPENDS ZAPD ${HARBOUR_CUSTOM_ASSETS}
+        COMMENT "Generating 2ship.o2r..."
+    )
+    add_custom_target(Generate2ShipOtr DEPENDS ${CMAKE_BINARY_DIR}/mm/2ship.o2r)
+    return()
+endif()
+
 add_subdirectory(mm)
 
 set_property(TARGET 2ship PROPERTY APPIMAGE_DESKTOP_FILE_TERMINAL YES)
