 float Fast3dGui::ComputeDpiScale() {
-#if (!defined(__APPLE__) || defined(__IOS__)) && !defined(__EMSCRIPTEN__)
-    // Only macOS and browsers separate logical points from physical pixels here; every
-    // other platform (iOS included, which runs ImGui in pixel space) keeps a scale of 1.
+#ifdef __IOS__
+    // iHarbour: ImGui runs in pixels on iOS, but the scale is still the screen's pixels per point, so fonts are
+    // rasterized for it and the game can size its menus in points.
+    if (mImpl.Metal.Window != nullptr && mImpl.Metal.Renderer != nullptr) {
+        int logicalW = 0, logicalH = 0, pixelW = 0, pixelH = 0;
+        SDL_GetWindowSize(static_cast<SDL_Window*>(mImpl.Metal.Window), &logicalW, &logicalH);
+        SDL_GetRendererOutputSize(mImpl.Metal.Renderer, &pixelW, &pixelH);
+        if (logicalW > 0 && pixelW > 0) {
+            return std::clamp(static_cast<float>(pixelW) / static_cast<float>(logicalW), 1.0f, 4.0f);
+        }
+    }
+    return 1.0f;
+#elif !defined(__APPLE__) && !defined(__EMSCRIPTEN__)
+    // Only macOS and browsers (and iOS, above) separate logical points from physical pixels here;
+    // every other platform keeps a scale of 1.
     return 1.0f;
 #else
     // Opengl.Window and Metal.Window alias the same union slot (both are the SDL_Window*).
